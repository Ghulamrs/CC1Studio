          ],
          "pattern": [
            {
              "regexp": "^(.+?):(\\d+):\\s(?!\\d).*$",
              "file": 1,
              "line": 2
            },
            {
              "regexp": "^\\s*\\^\\s(.*)$",
              "message": 1
            }
          ]
        }
      ]
    },
    {
      "label": "cc1: object",
      "type": "shell",
      "command": "${config:cc1.path}",
      "args": [
        "${file}",
        "-c",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.o"
      ],
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "cc1",
          "source": "cc1",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
        {
          "owner": "cc1",
          "source": "cc1",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": [
            {
              "regexp": "^(.+?):(\\d+):\\s(?!\\d).*$",
              "file": 1,
