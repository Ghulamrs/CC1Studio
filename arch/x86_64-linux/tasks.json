{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cc1: build and run",
      "type": "shell",
      "command": "${config:cc1.path}",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "cc1",
          "source": "cc1",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
        {
          "owner": "cc1",
          "source": "cc1",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": [
            {
              "regexp": "^(.+?):(\\d+):\\s(?!\\d).*$",
              "file": 1,
              "line": 2
            },
            {
              "regexp": "^\\s*\\^\\s(.*)$",
              "message": 1
            }
          ]
        }
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "cc1: build",
      "type": "shell",
      "command": "${config:cc1.path}",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "cc1",
          "source": "cc1",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
