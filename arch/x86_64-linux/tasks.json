            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": [
            {
              "regexp": "^(.+?):(\\d+):\\s(?!\\d).*$",
              "file": 1,
              "line": 2
            },
            {
              "regexp": "^\\s*\\^\\s(.*)$",
              "message": 1
            }
          ]
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cc1: assembly",
      "type": "shell",
      "command": "${config:cc1.path}",
      "args": [
