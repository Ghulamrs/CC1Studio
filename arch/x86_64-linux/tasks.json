            },
            {
              "regexp": "^\\s*\\^\\s(.*)$",
              "message": 1
            }
          ]
        }
      ]
    },
    {
      "label": "cc1: rebuild the compiler",
      "type": "shell",
      "command": "${workspaceFolder}/../arch/x86_64-linux/build-cc1.sh",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Builds cc1 from the checkout named in source/source.path, with gcc."
    }
  ]
}
